#!/bin/sh

# Kill any previous Mininet and tmux session (idempotent on re-run)
sudo pkill -9 -f '/usr/bin/mn' 2>/dev/null || true
sudo mn -c 2>/dev/null || true
sudo tmux kill-session -t my_session 2>/dev/null || true
sleep 2

# Wait for ONOS OpenFlow port to be ready (up to 180s)
echo "Waiting for ONOS to be ready on port 6653..."
count=0
until nc -z {{ hostvars[groups['onos_machine'][0]].internal_ip }} 6653 2>/dev/null || [ $count -ge 180 ]; do
    sleep 5
    count=$((count + 5))
done
echo "ONOS port 6653 ready (waited ${count}s)"

# Start a new tmux session named "my_session"
tmux new-session -d -s my_session

# Run mininet topology
tmux split-window -t my_session -h "cd {{ user_home.stdout }} && sudo mn \
  --custom {{ user_home.stdout }}/example.py,{{ user_home.stdout }}/sflow-rt/extras/sflow.py \
  --topo mytopo --mac --switch=ovs,protocols=OpenFlow13 --controller=remote,ip={{ hostvars[groups['onos_machine'][0]].internal_ip }},port=6653"

# Wait until Mininet has created the OVS bridges (up to 120s)
echo "Waiting for Mininet to create OVS bridges..."
count=0
until sudo ovs-vsctl list-br 2>/dev/null | grep -q "s1" || [ $count -ge 120 ]; do
    sleep 2
    count=$((count + 2))
done

if ! sudo ovs-vsctl list-br 2>/dev/null | grep -q "s1"; then
    echo "ERROR: Mininet failed to create OVS bridges after 120s — check ONOS connectivity"
    exit 1
fi
echo "Mininet bridges ready (s1, s2, s3)"

# Create GRE tunnels between Mininet switches and Kubernetes nodes
echo "Creating GRE tunnel: s1 -> master ({{hostvars['master']['internal_ip']}})"
sudo ovs-vsctl --may-exist add-port s1 int1
sudo ovs-vsctl set interface int1 type=gre options:remote_ip={{hostvars['master']['internal_ip']}}

echo "Creating GRE tunnel: s2 -> worker1 ({{hostvars['worker1']['internal_ip']}})"
sudo ovs-vsctl --may-exist add-port s2 int2
sudo ovs-vsctl set interface int2 type=gre options:remote_ip={{hostvars['worker1']['internal_ip']}}

echo "Creating GRE tunnel: s3 -> worker2 ({{hostvars['worker2']['internal_ip']}})"
sudo ovs-vsctl --may-exist add-port s3 int3
sudo ovs-vsctl set Interface int3 type=gre options:remote_ip={{hostvars['worker2']['internal_ip']}}

# Configure sFlow on each bridge (clear first to avoid duplicates on re-run)
echo "Configuring sFlow on Mininet bridges -> {{ sflow_ip }}:6343"
for bridge in s1 s2 s3; do
    sudo ovs-vsctl --if-exists clear bridge $bridge sflow
    sudo ovs-vsctl -- --id=@sflow create sflow \
        agent={{ hostvars[groups['sflow_machine'][0]].sflow_iface }} \
        target="{{ sflow_ip }}\:6343" \
        header=128 sampling=64 polling=10 \
        -- set bridge $bridge sflow=@sflow
done
echo "topology.sh complete"