"""Custom topology example2

An example of 3 switches connected to each other.
K3s hosts (master, worker1, worker2) connect via GRE tunnels
configured in topology.sh.j2


                           switch ----- switch
                               \         /
                                \       /
                                 \     /
                                  switch


Adding the 'topos' dict with a key/value pair to generate our newly defined
topology enables one to pass in '--topo=mytopo' from the command line.
"""

from mininet.topo import Topo
from mininet.net import Mininet
from mininet.link import TCLink

class MyTopo(Topo):
    "Simple topology example."

    def build(self):
        "Create custom topo."

        s1 = self.addSwitch('s1')
        s2 = self.addSwitch('s2')
        s3 = self.addSwitch('s3')

        # Add links between switches
        self.addLink(s1, s2, cls=TCLink, bw=50, delay='5ms')
        self.addLink(s1, s3, cls=TCLink, bw=50, delay='5ms')
        self.addLink(s2, s3, cls=TCLink, bw=50, delay='5ms')

topos = {'mytopo': (lambda: MyTopo())}
